# Dev: docker compose -f docker-compose.dev.yml up -d  (Postgres ở 127.0.0.1:5433)
DATABASE_URL=postgresql://cms:CHANGE_ME@127.0.0.1:5433/cms
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3002
CORS_ORIGINS=

# Cloudflare R2 (để trống R2_BUCKET = lưu local)
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Custom domain của bucket; có thì ảnh serve thẳng từ CDN
R2_PUBLIC_URL=

# Rebuild site khi publish (fine-grained PAT, chỉ repo site)
GITHUB_DISPATCH_TOKEN=
SITE_REPO=qkenn04/qkenn-site
